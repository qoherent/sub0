{
  "name": "subzero",
  "version": "0.1.0-preview.1",
  "description": "Delegate a skill's work to an isolated pi child on another model, through one MCP tool.",
  "license": "Apache-2.0",
  "author": {
    "name": "Qoherent"
  },
  "keywords": [
    "delegation",
    "subagents",
    "pi",
    "mcp",
    "model-routing"
  ],
  "mcpServers": {
    "subzero": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/subzero",
        "--bundle",
        "server"
      ],
      "env": {
        "SUBZERO_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "SUBZERO_DATA": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
