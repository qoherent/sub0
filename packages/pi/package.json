{
  "name": "@subzero/pi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19.0" },
  "type": "module",
  "exports": {
    ".": {
      "development": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "pi": {
    "extensions": ["./dist/index.js"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"Promise.all(process.argv.slice(1).map(p=>require('node:fs/promises').access(p))).catch(()=>{console.error('Build output is missing; run npm run build before packing.');process.exit(1)})\" dist/index.js dist/index.d.ts"
  },
  "dependencies": {
    "@subzero/runtime": "0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4"
  }
}
