{
  "name": "subzero-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --conditions=development --test packages/*/test/*.test.ts packages/*/test/*.test.mjs",
    "test:live": "npm run build && node --env-file=.env packages/pi/test/live-pi.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
